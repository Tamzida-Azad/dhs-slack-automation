# Copy to .env and fill in your organization values (never commit .env).

# Developer portal (My DHS source)
DHS_PORTAL_HOME=https://your-org.example.com/
DHS_PORTAL_MY_DHS=https://your-org.example.com/dashboard/my-dhs

# Slack workspace + channels (IDs from app.slack.com/client/TEAM_ID/CHANNEL_ID)
DHS_SLACK_WORKSPACE_URL=https://your-workspace.slack.com/
DHS_SLACK_TEAM_ID=T0000000000
DHS_SLACK_CHANNELS=daily-head-start:G0000000000,team-qa:G0000000001
DHS_CHANNEL_ORDER=daily-head-start,team-qa
DHS_WORKSPACE_HINT=Your Workspace Name

# Optional: only if session capture cannot infer Supabase host from network traffic
# DHS_SUPABASE_URL=https://your-project.supabase.co
